<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================================
     CycloneDDS configuration  -  optimized for a dedicated Gigabit Ethernet
     link between the laptop (perception) and the Raspberry Pi (sensors/odom).

     This file is regenerated by scripts/configure_network.sh from env.sh, so
     the interface name and peer IP below match ROS_IFACE / PI_IP. Edit env.sh
     and re-run configure_network.sh rather than hand-editing for those values.

     Pointed to via:  export CYCLONEDDS_URI=file://.../cyclonedds.xml
     ========================================================================= -->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <General>
      <!-- Bind DDS to the robot NIC so traffic does NOT leak onto WiFi/VPN -->
      <Interfaces>
        <NetworkInterface name="eno1" priority="default" multicast="default"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <!-- D435i color+depth frames are large; allow big DDS messages -->
      <MaxMessageSize>65500B</MaxMessageSize>
      <FragmentSize>4000B</FragmentSize>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>30</MaxAutoParticipantIndex>
      <!-- Unicast peer = robustness if multicast is flaky on the link -->
      <Peers>
        <Peer address="192.168.50.2"/>
      </Peers>
    </Discovery>

    <Internal>
      <!-- Bigger buffers for sustained image/pointcloud throughput on GbE -->
      <SocketReceiveBufferSize min="10MB"/>
      <Watermarks>
        <WhcHigh>2MB</WhcHigh>
      </Watermarks>
      <MultipleReceiveThreads enabled="true"/>
    </Internal>

    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
