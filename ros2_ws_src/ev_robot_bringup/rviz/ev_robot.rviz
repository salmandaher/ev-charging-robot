# RViz2 config for the EV-charging robot (STEP 13)
# Displays: TF, RobotModel, RGB image, Depth image, Odometry, Path, Costmaps,
#           nvblox ESDF map slice, and nvblox mesh.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.5

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Image
      Name: RGB (color)
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile

    - Class: rviz_default_plugins/Image
      Name: Depth (aligned)
      Enabled: true
      Topic:
        Value: /camera/aligned_depth_to_color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile

    - Class: rviz_default_plugins/Odometry
      Name: VSLAM Odometry
      Enabled: true
      Topic:
        Value: /visual_slam/tracking/odometry
        Reliability Policy: Best Effort
      Keep: 100
      Covariance:
        Value: false

    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
      Color: 0; 255; 0

    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
      Color: 255; 0; 255

    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color Scheme: costmap

    - Class: rviz_default_plugins/Map
      Name: Nvblox ESDF Slice
      Enabled: true
      Topic:
        Value: /nvblox_node/map_slice
        Reliability Policy: Best Effort
      Color Scheme: costmap

    # Requires the nvblox_rviz_plugin (present inside the Isaac ROS container)
    - Class: nvblox_rviz_plugin/NvbloxMesh
      Name: Nvblox Mesh
      Enabled: true
      Topic:
        Value: /nvblox_node/mesh
        Reliability Policy: Best Effort

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 0.7
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 1000
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: false
